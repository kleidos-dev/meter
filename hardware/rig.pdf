      <dc:format>application/pdf</dc:format>
      <dc:title><rdf:Alt><rdf:li xml:lang="x-default">Kleidos bench meter rig schematic</rdf:li></rdf:Alt></dc:title>
      <dc:description><rdf:Alt><rdf:li xml:lang="x-default">Wiring of the Kleidos bench meter: an INA228 across a 0.1 Î© shunt between a board's cell and the board, with the relays that open the lead and bypass the shunt. Its second sheet rewires the same parts for the shunt's calibration against a 100 Î© reference, four-wire.</rdf:li></rdf:Alt></dc:description>
      <dc:creator><rdf:Seq><rdf:li>JosÃ© M. Requena Plens</rdf:li></rdf:Seq></dc:creator>
