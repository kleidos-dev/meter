	(text "Notes"
		(exclude_from_sim no)
		(at 20.32 157.48 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "85e8353f-3300-4b8c-8cbb-2ff08fc36a54")
	)
	(text "HW-316 (U3): only K1 is used, the lead. SRD-05VDC-SL-C, Form C. Low-level trigger, VCC 5 V, JD-VCC fitted (JP1)."
		(exclude_from_sim no)
		(at 20.32 162.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b106eacc-9970-4ef7-82ee-0286a6203ce5")
	)
	(text "K1 stays mechanical: NC is closed at rest, so the DUT is fed with the meter off, and no on-resistance sits in series."
		(exclude_from_sim no)
		(at 20.32 164.719 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "fe5b320c-c3d0-4af6-8b4a-236965cfaa8e")
	)
	(text "IN low (~2 mA) = coil on; IN high (3.3 V) or floating = off. Only IN1 is wired: IN2-IN4 float, so K2-K4 never energize."
		(exclude_from_sim no)
		(at 20.32 166.878 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5c5fbfc9-5745-4240-85e4-350bb3796037")
	)
	(text "GPIO16 (T9) and GPIO17 (T10) reach nothing: the firmware still drives them as the spares k3 and k4, with nothing attached."
		(exclude_from_sim no)
		(at 20.32 169.037 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "69277318-5877-49b2-839f-40ec30899999")
	)
	(text "U4, Relay 2 Click: two LCA717, normally open, 0.15 Ω max, 3 ms max each way at 5 mA. RL1 drawn: control on PWM (16), active high."
		(exclude_from_sim no)
		(at 20.32 171.196 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "83f690f8-ebbb-4f48-85d8-f7bfde42cf0a")
	)
	(text "On the bench RL2 is fitted: control on mikroBUS AN (1), the RELAY2 terminals. The same circuit (MikroE: RL1 = PWM, RL2 = AN)."
		(exclude_from_sim no)
		(at 20.32 173.355 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "62546958-5e7f-4ff5-8dbe-bc9005c90f83")
	)
	(text "Image meter_relay2: GPIO15 low at boot and reset, high closes the bypass. The plain meter image drives it high: never with U4."
		(exclude_from_sim no)
		(at 20.32 175.514 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2e2e9480-008a-4b4a-860b-1fdb729cc063")
	)
	(text "Released (meter off, booting, reset): K1 NC closed, the DUT fed through the shunt; RL1 open (no LED current), no bypass."
		(exclude_from_sim no)
		(at 20.32 177.673 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b541c4b0-1901-49d6-8939-de80c4bccf53")
	)
	(text "ROUT:NULL ON: RL1 closes, settles, then K1 opens: the shunt carries nothing and the DUT stays fed through RL1."
		(exclude_from_sim no)
		(at 20.32 179.832 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "16cdb857-6f5f-48aa-848a-a0d50fb76110")
	)
	(text "ROUT:NULL OFF: K1 recloses, settles, then RL1 opens. RL1 closed across a closed K1 bypasses most of the shunt."
		(exclude_from_sim no)
		(at 20.32 181.991 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5bd7cd62-c3a7-496b-8df1-40b9abc1427e")
	)
	(text "Pigtail 2 lands on the VBUS screw and JP2 carries it to VIN+: VBUS reads the cell's side (CAL:VBUS SOUR)."
		(exclude_from_sim no)
		(at 20.32 184.15 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5f20f8cb-1012-47b7-893e-f1a2f41967ed")
	)
	(text "Negatives are not switched. K1 and RL1 sit outside the Kelvin sense: their contacts add burden, not error."
		(exclude_from_sim no)
		(at 20.32 186.309 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ce9bd05d-831f-4ca0-861b-5a72e81d9b30")
	)
	(text "RL1's terminals hold the cell's +: keep them and every contact screw clear of G; K1 NO is live whenever K1 is on."
		(exclude_from_sim no)
		(at 20.32 188.468 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "e9dfce3d-52d0-4b37-808a-f808992906c6")
	)
	(text "VCC only from T21, the carrier's own 5 V: never a supply that can be up while the meter's 3.3 V is down."
		(exclude_from_sim no)
		(at 20.32 190.627 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9e5d9f1e-66f1-4b3e-880e-c077279a9c3a")
	)
	(text "U3's and U4's GND go to G (T22) on the bench, with wires of their own."
		(exclude_from_sim no)
		(at 20.32 192.786 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1a8e850b-5e37-4682-8e86-c7654a88b04c")
	)
	(text "R100's value is the calibration registry's (calibration/), never this drawing's. Sheet 2 draws its calibration."
		(exclude_from_sim no)
		(at 20.32 194.945 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d32a2e2e-bb85-41bb-87d8-5d0ed6c98d7a")
	)
