# Mutant FW07-alatch: The header reads ALATCH off a bit two below it.
# Applied by scripts/run_mutants.sh to a copy of the tree; the host tests must fail.

diff --git a/firmware/src/console_commands.cpp b/firmware/src/console_commands.cpp
--- a/firmware/src/console_commands.cpp
+++ b/firmware/src/console_commands.cpp
@@ -1329,7 +1329,7 @@ void Console::cmdFetchHeader( Call& ) noexcept {
     w.field( "shunt_cal", device_->shuntCal() );
     w.field( "range", static_cast<std::uint32_t>( range ) );
     hexField( w, "diag_cfg", device_->diagConfig(), 4U );
-    w.field( "alatch", bits::field( device_->diagConfig(), kDiagAlatch, kDiagAlatchShift ) );
+    w.field( "alatch", bits::field( device_->diagConfig(), kDiagAlatch >> 2U, kDiagAlatchShift - 2U ) );
     hexField( w, "sovl", device_->shuntOverLimit(), 4U );
     hexField( w, "suvl", device_->shuntUnderLimit(), 4U );
     hexField( w, "mode", spec.mode, 1U );
