diff --git a/firmware/src/heap_monitor.cpp b/firmware/src/heap_monitor.cpp
--- a/firmware/src/heap_monitor.cpp
+++ b/firmware/src/heap_monitor.cpp
@@ -137,8 +137,7 @@
             .fetch_add( 1, std::memory_order_relaxed );
         return;
     }
-    (void)( allocation ? s.sinceMainAllocs : s.sinceMainFrees )
-        .fetch_add( 1, std::memory_order_relaxed );
+    (void)allocation;
 }

