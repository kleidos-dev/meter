# Mutant FW04-parkset: the bank parks the default map's pins whatever map it runs.
# Applied by scripts/run_mutants.sh to a copy of the tree; the host tests must fail.

diff --git a/firmware/src/relay.cpp b/firmware/src/relay.cpp
--- a/firmware/src/relay.cpp
+++ b/firmware/src/relay.cpp
@@ -172,5 +172,5 @@
     // Every relay is released: now the pins no role of the map holds are given
     // a defined level.
-    park( pinmap::parkedSet( map ) );
+    park( pinmap::parkedSet( pinmap::kDefaultMap ) & ~pinmap::pinBit( map.pins[3] ) );
     return ready_;
 }
