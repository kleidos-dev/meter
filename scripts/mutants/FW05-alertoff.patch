# Mutant FW05-alertoff: the pin ALERT leaves keeps its edge interrupt.
# Applied by scripts/run_mutants.sh to a copy of the tree; the host tests must fail.

diff --git a/firmware/src/sampler.cpp b/firmware/src/sampler.cpp
--- a/firmware/src/sampler.cpp
+++ b/firmware/src/sampler.cpp
@@ -408,5 +408,4 @@
     // The pin ALERT leaves latches nothing more, whatever takes it next.
     stopListening( alertPin_ );
-    gpio_ll_set_intr_type( &GPIO, static_cast<std::uint32_t>( alertPin_ ), GPIO_INTR_DISABLE );
     engineReady_ = connectAlert( pin, pullUp );
 }
