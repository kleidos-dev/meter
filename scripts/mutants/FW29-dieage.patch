diff --git a/firmware/src/sampler.cpp b/firmware/src/sampler.cpp
--- a/firmware/src/sampler.cpp
+++ b/firmware/src/sampler.cpp
@@ -401,7 +401,7 @@
         return 0;
     }
     const auto now = static_cast<std::uint64_t>( esp_timer_get_time() );
-    return ( now > stamp ) ? ( now - stamp ) : 0U;
+    return ( now > stamp ) ? ( now - stamp ) : 1U;
 }

