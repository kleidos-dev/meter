# Mutant FW05-relaypark: a relay's old pin is parked toward the level that energizes it.
# Applied by scripts/run_mutants.sh to a copy of the tree; the host tests must fail.

diff --git a/firmware/src/relay.cpp b/firmware/src/relay.cpp
--- a/firmware/src/relay.cpp
+++ b/firmware/src/relay.cpp
@@ -192,7 +192,7 @@
     for ( const std::size_t channel : { kLead, kBypass } ) {
         const auto gpio = static_cast<std::int32_t>( left[channel].pin );
         if ( !pinmap::held( map, gpio ) ) {
-            parkPin( pinmap::pinBit( gpio ), releaseLevel( left[channel].drive ) != 0U );
+            parkPin( pinmap::pinBit( gpio ), releaseLevel( left[channel].drive ) == 0U );
         }
     }
 }
