# Mutant FW04-held: a stored bus falls back though another role holds the default bus pins.
# Applied by scripts/run_mutants.sh to a copy of the tree; the host tests must fail.

diff --git a/firmware/src/pin_boot.cpp b/firmware/src/pin_boot.cpp
--- a/firmware/src/pin_boot.cpp
+++ b/firmware/src/pin_boot.cpp
@@ -82,7 +82,7 @@
         return result;
     }
     const pinmap::PinMap fallback = pinmap::withBusOf( pins.map, pinmap::kDefaultMap );
-    if ( pinmap::validate( fallback ).problem != pinmap::Problem::None ) {
+    if ( pinmap::validate( fallback ).problem == pinmap::Problem::Missing ) {
         pins.bus = Bus::Held;  // one of its pins is another role's
         return result;
     }
