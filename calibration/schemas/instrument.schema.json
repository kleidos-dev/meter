{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kleidos.meter.instrument/1",
  "title": "One instrument and its calibration history",
  "description": "The file is named by the instrument's serial (*IDN? field 3, a digest of its factory MAC, firmware/src/identity.h). Events are append-only and in the order they happened: a correction is a new event. Resistances are integers in nano-ohms, relative terms integers in ppm.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "serial", "label", "events"],
  "properties": {
    "schema": { "const": "kleidos.meter.instrument/1" },
    "serial": { "type": "string", "pattern": "^KM-[0-9A-F]{10}$" },
    "label": { "type": "string" },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/nominal_declared" },
          { "$ref": "#/$defs/as_found" },
          { "$ref": "#/$defs/hardware_change" },
          { "$ref": "#/$defs/calibration_accepted" },
          { "$ref": "#/$defs/calibration_not_applied" }
        ]
      }
    }
  },
  "$defs": {
    "event_id": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{2}$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{2}:[0-9]{2}$" },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^records/[A-Za-z0-9_./-]+$", "description": "Relative to calibration/." },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "nominal_declared": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "device", "notes"],
      "properties": {
        "id": { "$ref": "#/$defs/event_id" },
        "kind": { "const": "nominal_declared" },
        "device": {
          "type": "object",
          "additionalProperties": false,
          "required": ["shunt_uohm", "cal_tag"],
          "properties": { "shunt_uohm": { "type": "integer" }, "cal_tag": { "type": "string" } }
        },
        "notes": { "$ref": "#/$defs/notes" }
      }
    },
    "as_found": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "record", "notes"],
      "properties": {
        "id": { "$ref": "#/$defs/event_id" },
        "kind": { "const": "as_found" },
        "record": { "$ref": "#/$defs/file" },
        "notes": { "$ref": "#/$defs/notes" }
      }
    },
    "hardware_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "configuration", "voids_calibration", "what"],
      "properties": {
        "id": { "$ref": "#/$defs/event_id" },
        "kind": { "const": "hardware_change" },
        "configuration": { "type": "string", "description": "The configuration the instrument is in from this event on." },
        "voids_calibration": { "type": "boolean", "description": "True when anything inside the Kelvin sense moved: the shunt, the breakout, the sense wires." },
        "what": { "type": "string", "minLength": 1 }
      }
    },
    "range_points": {
      "type": "object",
      "additionalProperties": false,
      "required": ["points_nohm"],
      "properties": {
        "points_nohm": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
        "profile": { "type": "string" }
      }
    },
    "calibration_not_applied": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "verdict", "configuration", "taken_at", "why"],
      "properties": {
        "id": { "$ref": "#/$defs/event_id" },
        "kind": { "const": "calibration" },
        "verdict": { "enum": ["refused", "superseded"], "description": "Filed because it is knowledge; never selected." },
        "configuration": { "type": "string" },
        "taken_at": { "$ref": "#/$defs/timestamp" },
        "firmware": { "type": "string" },
        "why": { "type": "string", "minLength": 1 },
        "ranges": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "0": { "$ref": "#/$defs/range_points" }, "1": { "$ref": "#/$defs/range_points" } }
        },
        "device": { "type": "object" },
        "record": { "$ref": "#/$defs/file" },
        "raw_log": { "$ref": "#/$defs/file" }
      }
    },
    "calibration_accepted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "verdict", "configuration", "taken_at", "method", "firmware", "reference", "conditions", "ranges", "range_split_ppm", "budget", "u_c_ppm", "coverage_k", "expanded_ppm", "device", "record", "raw_log"],
      "properties": {
        "id": { "$ref": "#/$defs/event_id" },
        "kind": { "const": "calibration" },
        "verdict": { "const": "accepted" },
        "configuration": { "type": "string" },
        "taken_at": { "$ref": "#/$defs/timestamp", "description": "The host's clock, with its offset: the instrument has none." },
        "method": { "enum": ["two_point_reference/manual", "two_point_reference/guided"] },
        "firmware": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "reference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["part", "nominal_nohm", "tolerance_ppm", "tcr_ppm_per_c", "certificate"],
          "properties": {
            "part": { "type": "string" },
            "nominal_nohm": { "type": "integer", "minimum": 1 },
            "tolerance_ppm": { "type": "integer", "minimum": 0 },
            "tcr_ppm_per_c": { "type": "number", "minimum": 0 },
            "certificate": { "type": ["string", "null"] }
          }
        },
        "conditions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile", "vshct_us", "avg", "samples_per_point", "null_s", "null_path", "die_mc", "joints", "order"],
          "properties": {
            "profile": { "enum": ["STATE", "SLEEP"] },
            "vshct_us": { "type": "integer" },
            "avg": { "type": "integer" },
            "samples_per_point": { "type": "integer", "minimum": 1 },
            "null_s": { "type": "integer", "minimum": 1 },
            "null_path": { "type": "string" },
            "die_mc": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer" } },
            "joints": { "enum": ["screwed", "clipped", "twisted", "soldered"] },
            "order": { "type": "string", "description": "The order the ranges were measured in, block by block." },
            "cell_on": { "type": "string" }
          }
        },
        "ranges": {
          "type": "object",
          "additionalProperties": false,
          "required": ["0", "1"],
          "properties": { "0": { "$ref": "#/$defs/range_result" }, "1": { "$ref": "#/$defs/range_result" } }
        },
        "range_split_ppm": { "type": "integer", "minimum": 0 },
        "budget": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["term", "limit_ppm", "distribution", "u_ppm", "source"],
            "properties": {
              "term": { "type": "string" },
              "limit_ppm": { "type": "number", "minimum": 0 },
              "distribution": { "enum": ["rectangular", "normal", "measured"] },
              "u_ppm": { "type": "integer", "minimum": 0, "description": "The standard uncertainty: limit over the distribution's divisor." },
              "source": { "type": "string" }
            }
          }
        },
        "u_c_ppm": { "type": "integer", "minimum": 0 },
        "coverage_k": { "type": "number", "minimum": 1 },
        "expanded_ppm": { "type": "integer", "minimum": 0 },
        "device": { "$ref": "#/$defs/working_copy" },
        "acknowledged": { "type": "string", "description": "Why a move past the normalized error of 1 is accepted." },
        "notes": { "$ref": "#/$defs/notes" },
        "record": { "$ref": "#/$defs/file" },
        "raw_log": { "$ref": "#/$defs/file" }
      }
    },
    "range_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["points_nohm", "mean_nohm", "sd_ppm", "null_pv", "applied_nohm", "u_ppm"],
      "properties": {
        "points_nohm": { "type": "array", "minItems": 2, "items": { "type": "integer", "minimum": 1 } },
        "mean_nohm": { "type": "integer", "minimum": 1 },
        "sd_ppm": { "type": "integer", "minimum": 0 },
        "null_pv": {
          "type": "object",
          "additionalProperties": false,
          "required": ["before", "after"],
          "properties": { "before": { "type": ["integer", "null"] }, "after": { "type": ["integer", "null"] } }
        },
        "applied_nohm": { "type": "integer", "minimum": 1, "description": "The value QA uses for this range." },
        "u_ppm": { "type": "integer", "minimum": 0, "description": "Its standard uncertainty (k = 1)." },
        "u_ppm_own": { "type": "string", "description": "Why this range's u differs from u_c." }
      }
    },
    "working_copy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shunt_uohm_r0", "shunt_uohm_r1", "cal_tag", "cal_date", "vbus_side"],
      "description": "What the event wrote to the instrument: the working copy it expects to find there (CALibration:DATA?).",
      "properties": {
        "shunt_uohm_r0": { "type": "integer", "minimum": 50000, "maximum": 200000 },
        "shunt_uohm_r1": { "type": "integer", "minimum": 50000, "maximum": 200000 },
        "cal_tag": { "type": "string", "pattern": "^[A-Za-z0-9_.+-]{1,23}$" },
        "cal_date": { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$" },
        "vbus_side": { "enum": ["source", "unknown"] }
      }
    }
  }
}
